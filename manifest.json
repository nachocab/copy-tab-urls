{
  "manifest_version": 3,
  "name": "Copy Selected Tab URLs",
  "version": "1.0",
  "description": "Copies the URLs of the selected (highlighted) tabs to the clipboard, one per line.",
  "permissions": ["tabs"],
  "action": {
    "default_title": "Copy selected tab URLs",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      }
    }
  }
}
